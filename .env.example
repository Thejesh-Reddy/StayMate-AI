SERPAPI_KEY=your_serpapi_key_here

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_CLASSIFIER_MODEL=llama3.2

DATABASE_PATH=staymate.db
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

NOMINATIM_USER_AGENT=STAYMATE-AI/1.0 (hotel chatbot)

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
MONGODB_DATABASE=staymate_ai
MONGODB_COLLECTION=bookings

FLASK_SECRET_KEY=replace_with_a_secure_secret


# Groq API - Qwen model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions


# ==========================================
# EMAIL CONFIGURATION - BREVO HTTPS API
# ==========================================

# Email provider
EMAIL_PROVIDER=brevo

# Brevo API key
# Generate it from your Brevo dashboard.
# Leave the placeholder here; never commit a real API key.
BREVO_API_KEY=your_brevo_api_key_here

# Verified sender email configured in Brevo
MAIL_DEFAULT_SENDER=your_verified_sender@example.com

# Sender display name
MAIL_SENDER_NAME=STAYMATE AI
