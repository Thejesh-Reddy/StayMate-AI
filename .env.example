SERPAPI_KEY=your_serpapi_key_here

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_CLASSIFIER_MODEL=llama3.2

DATABASE_PATH=staymate.db
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

NOMINATIM_USER_AGENT=STAYMATE-AI/1.0 (hotel chatbot)

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
MONGODB_DATABASE=staymate_ai
MONGODB_COLLECTION=bookings

FLASK_SECRET_KEY=replace_with_a_secure_secret

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# Groq API - Qwen model
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions